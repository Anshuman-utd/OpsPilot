# Copy to .env.release and restrict it to your user (chmod 600).
OPSPILOT_ORIGIN=https://ops.example.com

# Use independent hex values from openssl rand -hex 24.
POSTGRES_PASSWORD=
DEMO_POSTGRES_PASSWORD=
GRAFANA_PASSWORD=

# Enable only on a dedicated demo installation.
FAULT_INJECTION_ENABLED=false
DEMO_ORDERS_ENABLED=false
DEMO_LAB_ENABLED=false

# Optional. Leave blank for deterministic investigation.
GROQ_API_KEY=
