# ==============================================================================
# OpsPilot Backend - Environment Variables Template
# ==============================================================================

# Application Configuration
APP_NAME=OpsPilot
APP_ENV=development
AUTH_REQUIRED=false
PUBLIC_ORIGIN=http://localhost:3000
SESSION_HOURS=12
DEMO_ORDERS_ENABLED=false
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot_dev@localhost:5433/opspilot

# Redis Configuration (Cache & Celery Broker)
REDIS_URL=redis://localhost:6380/0

# Observability Infrastructure Endpoints
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT_SECONDS=5.0
GRAFANA_URL=http://localhost:3001
TEMPO_URL=http://localhost:3200
LOKI_URL=http://localhost:3100

# Deterministic Incident Detection Settings
INCIDENT_DETECTION_ENABLED=true
INCIDENT_EVALUATION_INTERVAL_SECONDS=30

# Detection Rule Thresholds
HTTP_5XX_HIGH_THRESHOLD=0.05
HTTP_5XX_CRITICAL_THRESHOLD=0.20
P95_LATENCY_HIGH_SECONDS=1.0
P95_LATENCY_CRITICAL_SECONDS=3.0
PAYMENT_FAILURE_HIGH_THRESHOLD=20.0
PAYMENT_FAILURE_CRITICAL_THRESHOLD=50.0
ORDER_FAILURE_HIGH_THRESHOLD=20.0
ORDER_FAILURE_CRITICAL_THRESHOLD=50.0
DB_POOL_HIGH_THRESHOLD=75.0
DB_POOL_CRITICAL_THRESHOLD=90.0

MIN_TRAFFIC_REQUESTS=5
MIN_PAYMENT_SAMPLES=5
CONSECUTIVE_HEALTHY_CYCLES_FOR_RECOVERY=1

# LLM Configuration (Phase 4 Agentic Investigation)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=45.0
LLM_MAX_RETRIES=2

# Autonomous Investigation Settings (Single-pass deterministic LangGraph pipeline)
INVESTIGATION_ENABLED=true
AUTO_INVESTIGATION_ENABLED=false
INVESTIGATION_MAX_CONCURRENT=3

# Phase 5: Controlled Remediation & Recovery Settings
REMEDIATION_ENABLED=true
REMEDIATION_OPERATOR_ID=local-operator
REMEDIATION_OPERATOR_TOKEN=
REMEDIATION_APPROVAL_EXPIRY_MINUTES=30
REMEDIATION_EXECUTION_TIMEOUT_SECONDS=30.0
REMEDIATION_VERIFICATION_INTERVAL_SECONDS=10
REMEDIATION_VERIFICATION_TIMEOUT_SECONDS=180
REMEDIATION_CONSECUTIVE_HEALTHY_REQUIRED=3
REMEDIATION_MAX_CONCURRENT_EXECUTIONS=2

# Target Microservice Endpoints (Demo Environment)
ORDER_SERVICE_URL=http://localhost:8002
PAYMENT_SERVICE_URL=http://localhost:8003
API_GATEWAY_URL=http://localhost:8001
