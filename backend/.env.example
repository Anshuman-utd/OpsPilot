# ==============================================================================
# OpsPilot Backend - Environment Variables Template
# ==============================================================================

# Application Configuration
APP_NAME=OpsPilot
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot_dev@localhost:5433/opspilot

# Redis Configuration (Cache & Celery Broker)
REDIS_URL=redis://localhost:6380/0

# LLM Configuration (Planned for Phase 4 - Not required for Phase 1)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

