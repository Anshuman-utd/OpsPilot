  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Service Traffic & Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 15 }, "unit": "reqps" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "table" } },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total[1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "title": "HTTP Request Rate (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95 {{service}}"
        }
      ],
      "title": "HTTP Request Latency (p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total{status_code=~\"5..\"}[1m]))",
          "legendFormat": "5xx {{service}}"
        }
      ],
      "title": "HTTP 5xx Error Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 5,
      "title": "Business & Downstream Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (status) (rate(orders_created_total[1m]))",
          "legendFormat": "Orders {{status}}"
        }
      ],
      "title": "Orders Created Rate (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "id": 8,
      "targets": [
        {
          "expr": "sum by (status) (rate(payments_processed_total[1m]))",
          "legendFormat": "Payments {{status}}"
        }
      ],
      "title": "Payment Transactions Rate (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (reason) (increase(payment_failures_total[5m]))",
          "legendFormat": "Failure: {{reason}}"
        }
      ],
      "title": "Payment Failures (5m Trend)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 9,
      "title": "Resource & Connection Saturation",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percent" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 17 },
      "id": 10,
      "targets": [
        {
          "expr": "100 * (sum by (service) (db_pool_checked_out) / clamp_min(sum by (service) (db_pool_size), 1))",
          "legendFormat": "{{service}} Pool Saturation"
        }
      ],
      "title": "Database Connection Pool Saturation (%)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "id": 11,
      "targets": [
        {
          "expr": "sum by (service, target, status_code) (rate(downstream_requests_total[1m]))",
          "legendFormat": "{{service}} -> {{target}} [{{status_code}}]"
        }
      ],
      "title": "Downstream RPC Call Rate",
      "type": "timeseries"
    }
