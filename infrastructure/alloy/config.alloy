discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "service_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/opspilot-(.*)"
    target_label  = "service"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.service_logs.output
  forward_to = [loki.process.parse_structured_logs.receiver]
}

loki.process "parse_structured_logs" {
  stage.json {
    expressions = {
      level   = "level",
      service = "service",
    }
  }

  // Keep stream labels low-cardinality to prevent Loki stream explosion.
  // trace_id is extracted directly from the JSON log line by Grafana derivedFields.
  stage.labels {
    values = {
      level   = "level",
      service = "service",
    }
  }

  forward_to = [loki.write.local_loki.receiver]
}

loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
