# ==============================================================================
# OpsPilot Demo Microservices - Environment Variables Template
# ==============================================================================

# Application & Environment
DEMO_ENV=development
LOG_LEVEL=INFO
FAULT_INJECTION_ENABLED=false

# Demo PostgreSQL Database
# Local development on host uses 5434; Docker Compose uses demo-postgres:5432
DEMO_DATABASE_URL=postgresql+asyncpg://demo_user:demo_password@localhost:5434/demo_db

# Downstream Service URLs
# Local development uses localhost; Docker Compose uses service names
ORDER_SERVICE_URL=http://localhost:8002
PAYMENT_SERVICE_URL=http://localhost:8003

# OpenTelemetry Collector Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
